---
import fontsHref from "../styles/fonts.css?url";
import screenHref from "../styles/cv-screen.css?url";
import printHref from "../styles/cv-print.css?url";
import type { Locale } from "../i18n";
import { locales } from "../i18n";
import PostHog from '../components/posthog.astro'


interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="stylesheet" href={fontsHref} />
    <link rel="stylesheet" href={screenHref} media="screen" />
    <link rel="stylesheet" href={printHref} media="print" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" id="app-favicon" />
    <!-- Theme cookie + favicon: smiley when focused, SA SVG when blurred -->
    <script is:inline>
      (() => {
        const m = document.cookie.match(/(?:^|;\s*)theme=([^;]*)/);
        const t = m ? decodeURIComponent(m[1]) : null;
        if (t === "light" || t === "dark") {
          document.documentElement.dataset.theme = t;
        }
        const link = document.getElementById("app-favicon");
        if (!link) return;
        const dark =
          t === "dark" ||
          (t !== "light" &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);
        const sa = dark ? "/favicon-dark.svg" : "/favicon-light.svg";
        const smiley =
          "data:image/svg+xml," +
          encodeURIComponent(
            '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><text y=".9em" font-size="90">😊</text></svg>',
          );
        const sync = () => {
          const focused =
            document.visibilityState === "visible" && document.hasFocus();
          link.href = focused ? smiley : sa;
        };
        sync();
        document.addEventListener("visibilitychange", sync);
        window.addEventListener("focus", sync);
        window.addEventListener("blur", sync);
      })();
    </script>

    <PostHog />

    {
      locales.map((l) => (
        <link
          rel="alternate"
          hreflang={l}
          href={new URL(`/${l}/`, Astro.site ?? "https://example.com").pathname}
        />
      ))
    }
  </head>
  <body>
    <slot />
    <script>
      import { initCvInteractions } from "../scripts/cv-interactions";
      initCvInteractions();
    </script>
  </body>
</html>
