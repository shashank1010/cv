---
import type { Locale } from "../i18n/types";

interface Props {
  label: string;
  ariaLabel: string;
  locale: Locale;
}

const { label, ariaLabel, locale } = Astro.props;

// Map locale to PDF filename
const pdfFilename = locale === "en" ? "/CV.pdf" : `/CV-${locale}.pdf`;
---

<a
  class="pdf-download-link"
  aria-label={ariaLabel}
  href={pdfFilename}
  download={`Shashank Agarwal-UX Architect${locale === "en" ? "" : `-${locale}`}-${new Date().getFullYear()}.pdf`}
  title={label}
>
  <span class="pdf-download-link__label">{label}</span>
</a>

<style>
  /* Type + hover match nav items via cv.css (.site-nav__actions .pdf-download-link) */
  .pdf-download-link__label {
    font: inherit;
  }

  @media print {
    .pdf-download-link {
      display: none !important;
    }
  }
</style>
