---
import type { Locale } from "../i18n/types";
import { localeLabels, locales } from "../i18n/utils";

interface Props {
  locale: Locale;
  ariaLabel: string;
}

const { locale, ariaLabel } = Astro.props;

function hrefFor(target: Locale): string {
  if (target === "en") return "/";
  return `/${target}/`;
}

function codeFor(l: Locale): string {
  return l.toUpperCase();
}
---

<div class="lang-dropdown">
  <button
    type="button"
    class="lang-dropdown__trigger"
    id="lang-menu-trigger"
    popovertarget="lang-menu"
    aria-haspopup="menu"
    aria-label={ariaLabel}
  >
    <span class="lang-dropdown__code">{codeFor(locale)}</span>
    <svg class="lang-dropdown__icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
      <path d="m7 10 5 5 5-5z" fill="currentColor" />
    </svg>
  </button>

  <ul id="lang-menu" class="lang-dropdown__menu" popover role="menu">
    {
      locales.map((l) => (
        <li role="none">
          <a
            class:list={["lang-dropdown__item", { "is-active": l === locale }]}
            href={hrefFor(l)}
            hreflang={l}
            lang={l}
            role="menuitem"
            aria-current={l === locale ? "page" : undefined}
            data-ph-event="language_change"
            data-ph-from={locale}
            data-ph-to={l}
            data-ph-href={hrefFor(l)}
          >
            <span class="lang-dropdown__item-code" aria-hidden="true">{codeFor(l)}</span>
            <span class="lang-dropdown__item-name">{localeLabels[l]}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .lang-dropdown {
    position: relative;
    display: inline-block;
    z-index: 200;
  }

  /* Type/chrome match menu items via cv.css — layout + anchor only here */
  .lang-dropdown__trigger {
    anchor-name: --lang-menu;
  }

  /* Always visible on the trigger — same weight as other nav items */
  .lang-dropdown__code {
    display: inline-block;
    font-weight: inherit;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .lang-dropdown__icon {
    display: inline-block;
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    margin-inline-end: -6px;
    transition: transform 0.2s ease;
  }

  .lang-dropdown:has(:popover-open) .lang-dropdown__icon {
    transform: rotate(180deg);
  }

  .lang-dropdown__menu {
    inset: unset;
    margin: 0;
    position: absolute;
    position-anchor: --lang-menu;
    top: anchor(bottom);
    right: anchor(right);
    margin-top: 0.5rem;
    padding: 0.35rem;
    list-style: none;
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: 4px;
    box-shadow: 0 4px 12px rgba(var(--shadow-ink), 0.12);
    min-width: 9.5rem;
  }

  .lang-dropdown__menu:popover-open {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .lang-dropdown__item {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.45rem;
    width: 100%;
    padding: 0.3rem 0.4rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--muted);
    text-decoration: none;
    border-radius: 4px;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .lang-dropdown__item:hover {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .lang-dropdown__item.is-active {
    color: var(--accent);
    background: var(--accent-soft);
    pointer-events: none;
  }

  /* Code chip — compact “avatar” next to the name */
  .lang-dropdown__item-code {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-width: 1.45rem;
    width: 1.45rem;
    height: 1.25rem;
    padding: 0 0.25rem;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid color-mix(in srgb, var(--accent) 18%, transparent);
    border-radius: 3px;
    line-height: 1;
  }

  .lang-dropdown__item-name {
    font-weight: 500;
    letter-spacing: 0.01em;
    color: inherit;
  }

  @media print {
    .lang-dropdown {
      display: none !important;
    }
  }
</style>
