---
import type { Locale } from "../i18n/types";
import { localeLabels, locales } from "../i18n/utils";

interface Props {
  locale: Locale;
  ariaLabel: string;
}

const { locale, ariaLabel } = Astro.props;

/**
 * Generate href for language switch.
 * With Astro i18n routing (prefixDefaultLocale: false):
 * - en → / or /en/
 * - de → /de/
 * - ru → /ru/
 */
function hrefFor(target: Locale): string {
  if (target === "en") return "/";
  return `/${target}/`;
}
---

<nav class="lang-switch" aria-label={ariaLabel}>
  <ul class="lang-switch__list">
    {
      locales.map((l) => (
        <li>
          <a
            class:list={["lang-switch__link", { "is-active": l === locale }]}
            href={hrefFor(l)}
            hreflang={l}
            lang={l}
            aria-current={l === locale ? "page" : undefined}
          >
            {localeLabels[l]}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .lang-switch {
    position: fixed;
    bottom: 1rem;
    right: 1rem;
    z-index: 50;
    display: flex;
    justify-content: center;
    transition: bottom 0.3s ease;
  }

  .lang-switch.is-hidden {
    bottom: -50vh;
    pointer-events: none;
  }

  .lang-switch__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.2rem;
    margin: 0;
    padding: 0.5rem 0.75rem;
    list-style: none;
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid var(--line);
    border-radius: 6px;
    box-shadow: 0 1px 2px rgba(26, 29, 35, 0.04);
    backdrop-filter: blur(10px);
  }

  .lang-switch__link {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    border-radius: 4px;
  }

  .lang-switch__link:hover {
    color: var(--accent);
    background: var(--accent-soft);
    text-decoration: none;
  }

  .lang-switch__link.is-active {
    color: var(--accent);
    background: var(--accent-soft);
  }

  @media print {
    .lang-switch {
      display: none !important;
    }
  }
</style>
