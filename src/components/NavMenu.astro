---
import type { Locale, Messages } from "../i18n";
import PDFDownloadButton from "./PDFDownloadButton.astro";
import LanguageDropdown from "./LanguageDropdown.astro";

interface Props {
  locale: Locale;
  t: Messages;
}

const { locale, t } = Astro.props;

const sectionLinks = [
  { href: "#intro", label: t.nav.intro },
  { href: "#skills", label: t.nav.skills },
  { href: "#experience", label: t.nav.experience },
  { href: "#hobbies", label: t.nav.hobbies },
] as const;
---

<div class="site-nav-sentinel" aria-hidden="true"></div>
<div class="site-nav-sticky">
  <nav class="site-nav" aria-label={t.nav.sectionsAria}>
    <!-- Declarative Popover invoker (mobile only via CSS) -->
    <button
      type="button"
      class="site-nav__toggle"
      popovertarget="nav-menu"
      aria-controls="nav-menu"
      aria-label="Toggle menu"
    >
      <svg class="site-nav__toggle-hamburger" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg class="site-nav__toggle-close" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Desktop: always visible, never a popover -->
    <ul class="site-nav__list site-nav__list--desktop">
      {
        sectionLinks.map(({ href, label }) => (
          <li>
            <a href={href} class="nav-link">
              {label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Mobile: pure Popover API drawer (no JS) -->
    <ul id="nav-menu" class="site-nav__list site-nav__list--drawer" popover>
      {
        sectionLinks.map(({ href, label }) => (
          <li>
            <a href={href} class="nav-link">
              {label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="site-nav__actions">
      <PDFDownloadButton label={t.nav.download} locale={locale} ariaLabel={`${t.nav.download} CV as PDF`} />
      <LanguageDropdown locale={locale} ariaLabel={t.nav.langAria} />
      <button
        type="button"
        class="site-nav__theme"
        data-theme-toggle
        aria-label={t.nav.themeAria}
        title={t.nav.themeAria}
      >
        <svg class="site-nav__theme-icon site-nav__theme-icon--sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <circle cx="12" cy="12" r="4" fill="currentColor" />
          <path
            fill="currentColor"
            d="M12 1.5a1 1 0 0 1 1 1V5a1 1 0 1 1-2 0V2.5a1 1 0 0 1 1-1Zm0 15a1 1 0 0 1 1 1v2.5a1 1 0 1 1-2 0V17.5a1 1 0 0 1 1-1ZM1.5 12a1 1 0 0 1 1-1H5a1 1 0 1 1 0 2H2.5a1 1 0 0 1-1-1Zm15 0a1 1 0 0 1 1-1H19.5a1 1 0 1 1 0 2H17.5a1 1 0 0 1-1-1ZM4.22 4.22a1 1 0 0 1 1.42 0L7.4 5.98A1 1 0 1 1 5.98 7.4L4.22 5.64a1 1 0 0 1 0-1.42Zm12.38 12.38a1 1 0 0 1 1.42 0l1.76 1.76a1 1 0 0 1-1.42 1.42l-1.76-1.76a1 1 0 0 1 0-1.42ZM18.36 4.22a1 1 0 0 1 0 1.42L16.6 7.4A1 1 0 1 1 15.18 5.98l1.76-1.76a1 1 0 0 1 1.42 0ZM5.98 15.18a1 1 0 0 1 1.42 1.42L5.64 18.36a1 1 0 1 1-1.42-1.42l1.76-1.76Z"
          />
        </svg>
        <svg class="site-nav__theme-icon site-nav__theme-icon--moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <!-- Medium crescent (Heroicons-style) — fuller than a thin C, not a full disc -->
          <path
            fill="currentColor"
            d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"
          />
        </svg>
      </button>
      <a class="site-nav__cta" href="#lets-talk" aria-label={t.cta.pokeAria}>
        {t.nav.letsTalk}
      </a>
    </div>
  </nav>
</div>

<style>
  .site-nav {
    anchor-name: --site-nav;
  }

  .site-nav__toggle {
    display: none;
    flex-direction: column;
    gap: 0.35rem;
    width: 32px;
    height: 32px;
    padding: 0.4rem;
    background: none;
    border: none;
    cursor: pointer;
    border-radius: 4px;
    transition: background-color 0.2s ease;
    order: -1;
    color: var(--muted);
    position: relative;
    font-family: inherit;
  }

  .site-nav__toggle:hover {
    background: var(--accent-soft);
  }

  .site-nav__toggle-hamburger {
    display: block;
    transition: opacity 0.2s ease;
  }

  .site-nav__toggle-close {
    display: none;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    transition: opacity 0.2s ease;
  }

  .site-nav:has(#nav-menu:popover-open) .site-nav__toggle-hamburger {
    opacity: 0;
    pointer-events: none;
  }

  .site-nav:has(#nav-menu:popover-open) .site-nav__toggle-close {
    display: block;
    opacity: 1;
  }

  .site-nav__actions {
    display: flex;
    gap: 0.15rem 0.25rem;
    align-items: center;
    margin-left: auto;
  }

  /* Drawer chrome (only visible when :popover-open; closed = UA display:none). */
  .site-nav__list--drawer {
    inset: unset;
    margin: 0;
    position: absolute;
    position-anchor: --site-nav;
    top: anchor(bottom);
    left: anchor(left);
    right: anchor(right);
    width: auto;
    flex-direction: column;
    gap: 0;
    padding: 0.5rem 0.65rem;
    list-style: none;
    background: var(--nav-bg);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
    border-right: 1px solid var(--line);
    border-bottom: none;
    border-radius: 0;
    box-shadow: 0 4px 12px rgba(var(--shadow-ink), 0.12);
    overflow: hidden;
  }

  .site-nav__list--drawer:popover-open {
    display: flex;
  }

  .site-nav__list--drawer > li {
    width: 100%;
    padding: 0.35rem 0;
  }

  .site-nav__list--drawer :is(a, button) {
    width: 100%;
    text-align: left;
    display: block;
    padding: 0.4rem 0;
    border-radius: 0;
    background: none;
  }

  .site-nav__list--drawer :is(a, button):hover {
    background: transparent;
    color: var(--accent);
  }

  /* Compact / hamburger nav below 850px */
  @media (min-width: 851px) {
    .site-nav__list--desktop {
      display: flex;
      gap: 0.15rem 0.25rem;
      align-items: center;
    }
  }

  @media (max-width: 850px) {
    .site-nav {
      flex-wrap: wrap;
      align-items: center;
      padding: 0.5rem 0.65rem;
      gap: 0;
    }

    .site-nav__toggle {
      display: flex;
      margin: 0;
      flex-shrink: 0;
    }

    .site-nav__list--desktop {
      display: none;
    }

    .site-nav__actions {
      order: 1;
      gap: 0.15rem 0.25rem;
      margin-left: auto;
      flex-shrink: 0;
      position: relative;
      z-index: 150;
    }
  }
</style>
