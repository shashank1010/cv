---
import type { Locale, Messages } from "../i18n";
import PDFDownloadButton from "./PDFDownloadButton.astro";
import LanguageDropdown from "./LanguageDropdown.astro";

interface Props {
  locale: Locale;
  t: Messages;
}

const { locale, t } = Astro.props;
---

<div class="site-nav-sentinel" aria-hidden="true"></div>
<div class="site-nav-sticky">
  <nav class="site-nav" aria-label={t.nav.sectionsAria}>
    <button class="site-nav__toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-menu">
      <svg class="site-nav__toggle-hamburger" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg class="site-nav__toggle-close" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <ul class="site-nav__list" id="nav-menu">
      <li><a href="#intro" class="nav-link">{t.nav.intro}</a></li>
      <li><a href="#skills" class="nav-link">{t.nav.skills}</a></li>
      <li><a href="#experience" class="nav-link">{t.nav.experience}</a></li>
      <li><a href="#hobbies" class="nav-link">{t.nav.hobbies}</a></li>
    </ul>

    <div class="site-nav__actions">
      <PDFDownloadButton label={t.nav.download} locale={locale} ariaLabel={`${t.nav.download} CV as PDF`} />
      <LanguageDropdown locale={locale} ariaLabel={t.nav.langAria} />
    </div>
  </nav>
</div>

<style>
  .site-nav__toggle {
    display: none;
    flex-direction: column;
    gap: 0.35rem;
    width: 32px;
    height: 32px;
    padding: 0.4rem;
    background: none;
    border: none;
    cursor: pointer;
    border-radius: 4px;
    transition: background-color 0.2s ease;
    order: -1;
    color: var(--muted);
    position: relative;
  }

  .site-nav__toggle:hover {
    background: var(--accent-soft);
  }

  .site-nav__toggle-hamburger {
    display: block;
    transition: opacity 0.2s ease;
  }

  .site-nav__toggle-close {
    display: none;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    transition: opacity 0.2s ease;
  }

  .site-nav__toggle[aria-expanded="true"] .site-nav__toggle-hamburger {
    opacity: 0;
    pointer-events: none;
  }

  .site-nav__toggle[aria-expanded="true"] .site-nav__toggle-close {
    display: block;
    opacity: 1;
  }

  .site-nav__list {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .site-nav__actions {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-left: auto;
  }

  @media (max-width: 640px) {
    .site-nav {
      flex-wrap: wrap;
      align-items: center;
      padding: 0.5rem 0.65rem;
      gap: 0;
    }

    .site-nav__toggle {
      display: flex;
      margin: 0;
      flex-shrink: 0;
    }

    .site-nav__list {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      width: 100%;
      order: 2;
      display: none;
      overflow: hidden;
      flex-direction: column;
      gap: 0;
      margin: 0;
      padding: 0.5rem 0.65rem;
      background: rgba(255, 255, 255, 0.94);
      border-top: 1px solid var(--line);
      border-left: 1px solid var(--line);
      border-right: 1px solid var(--line);
      box-shadow: 0 4px 12px rgba(26, 29, 35, 0.12);
    }

    .site-nav__toggle[aria-expanded="true"] ~ .site-nav__list {
      display: block;
    }

    .site-nav__list > li {
      width: 100%;
      padding: 0.35rem 0;
    }

    .site-nav__list :is(a, button) {
      width: 100%;
      text-align: left;
      display: block;
      padding: 0.4rem 0;
      border-radius: 0;
      background: none;
    }

    .site-nav__list :is(a, button):hover {
      background: transparent;
      color: var(--accent);
    }

    .site-nav__actions {
      order: 1;
      gap: 0.5rem;
      margin-left: auto;
      flex-shrink: 0;
      position: relative;
      z-index: 150;
    }
  }
</style>

<script>
  // Mobile menu toggle
  const toggleBtn = document.querySelector(".site-nav__toggle") as HTMLButtonElement;
  const navMenu = document.querySelector("#nav-menu") as HTMLElement;

  if (toggleBtn && navMenu) {
    toggleBtn.addEventListener("click", () => {
      const isExpanded = toggleBtn.getAttribute("aria-expanded") === "true";
      toggleBtn.setAttribute("aria-expanded", String(!isExpanded));
    });

    // Close menu when a nav link is clicked
    const navLinks = navMenu.querySelectorAll(".nav-link");
    navLinks.forEach((link) => {
      link.addEventListener("click", () => {
        toggleBtn.setAttribute("aria-expanded", "false");
      });
    });

    // Close menu when clicking outside
    document.addEventListener("click", (e) => {
      const nav = document.querySelector(".site-nav") as HTMLElement;
      if (!nav?.contains(e.target as Node)) {
        toggleBtn.setAttribute("aria-expanded", "false");
      }
    });
  }
</script>
